<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.knowledge.knowledgeagentplatform.mapper.DocumentMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.knowledge.knowledgeagentplatform.entity.Document">
        <id column="id" property="id" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="document_name" property="documentName" />
        <result column="document_path" property="documentPath" />
        <result column="knowledge_base_id" property="knowledgeBaseId" />
        <result column="process_status" property="processStatus" />
        <result column="document_content" property="documentContent" />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, create_time, update_time, document_name, document_path, knowledge_base_id, process_status, document_content
    </sql>

</mapper>
